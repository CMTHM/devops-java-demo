# Values used by compose.yaml (Docker Compose reads this file automatically)
# Training values only - in a real project never commit passwords; use secrets instead
MYSQL_ROOT_PASSWORD=root@123
MYSQL_DATABASE=trishadb
MYSQL_USER=trisha
MYSQL_PASSWORD=trisha@123

# Docker Hub image. deploy.ps1 sets IMAGE_TAG to a new value on each release.
DOCKERHUB_USER=<Keep your dockerhub username >
IMAGE_TAG=latest
